    {
      "id": "fb7abddb-03b8-4225-a8f9-2bc12f172b6b",
      "name": "Plan Sync",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        544
      ],
      "parameters": {
        "jsCode": "// Compare the Google Sheet (source of truth) with each data table and emit only the changes.\n// Columns that exist only in the data table (e.g. active, code_aliases, sage_vendor_id) are never touched.\nconst S = $('Build Config').first().json.cfg.SHEET_SYNC_CONFIG;\nconst CONFIG = {\n  DRY_RUN: S.dry_run === true,\n  DELETE_MISSING: S.delete_missing_rows === true,\n  MAX_DELETE_RATIO: Number(S.max_delete_ratio ?? 0.5),   // refuse to delete more than this share of a table in one run\n  TABLES: [\n    { key: 'location', sheet: 'Read Location Sheet', table: 'Load Location Master', keyCols: ['location_code'],\n      map: { 'Location #': ['location_number', 'number'], 'Location Name': ['location_name'], 'Ship-To Street Address': ['ship_to_street'],\n             'City': ['city'], 'State': ['state'], 'Zip': ['zip'], 'PO Suffix / Location Code': ['location_code', 'upper'],\n             'Sage Entity ID (locationid)': ['sage_entity_id'], 'ServiceTitan Tenant ID': ['st_tenant_id'] } },\n    { key: 'department', sheet: 'Read Department Sheet', table: 'Load Department Code', keyCols: ['business_unit_id'],\n      map: { 'Business Unit ID': ['business_unit_id'], 'Business Unit Name': ['business_unit_name'],\n             'Department Code': ['department_code'], 'Department Name': ['department_name'] } },\n    { key: 'vendor_map', sheet: 'Read Vendor Map Sheet', table: 'Load Vendor Account Map', keyCols: ['vendor_name', 'account_number'],\n      map: { 'Vendor Name': ['vendor_name'], 'Account Number': ['account_number'], 'Location Code': ['location_code', 'upper'],\n             'Source GL Code': ['gl_account'], 'Status': ['status'], 'Confirmed By Client?': ['confirmed_by_client', 'yesno'] } },\n  ],\n};\n\nconst str = v => (v === null || v === undefined) ? '' : String(v).trim();\nconst conv = (v, how) => {\n  const s = str(v);\n  if (how === 'number') return s === '' || isNaN(Number(s.replace(/,/g, ''))) ? null : Number(s.replace(/,/g, ''));\n  if (how === 'yesno') return /^(y|yes|true|1|x|✓|confirmed)$/i.test(s);\n  if (how === 'upper') return s ? s.toUpperCase() : null;\n  return s === '' ? null : s;\n};\nconst same = (a, b) => (typeof a === 'boolean' || typeof b === 'boolean') ? (a === true) === (b === true) : str(a) === str(b);\nconst keyOf = (row, cols) => cols.map(c => str(row[c]).toUpperCase()).join('|');\n\nconst out = [], summary = {};\nfor (const T of CONFIG.TABLES) {\n  const sheetRows = $(T.sheet).all().map(i => i.json).filter(r => r && Object.keys(r).length && !r.error);\n  const tableRows = $(T.table).all().map(i => i.json).filter(r => r && r.id !== undefined);\n  const s = summary[T.key] = { sheet_rows: 0, table_rows: tableRows.length, inserts: 0, updates: 0, deletes: 0, skipped: [], changes: [] };\n\n  // Sheet -> table columns. A header that is missing from the sheet stops this table's sync.\n  const headers = new Set(sheetRows.flatMap(r => Object.keys(r)));\n  const missingHeaders = Object.keys(T.map).filter(h => !headers.has(h));\n  if (missingHeaders.length) { s.skipped.push(`Sheet is missing columns: ${missingHeaders.join(', ')}; table not synced`); continue; }\n\n  const wanted = new Map();\n  for (const r of sheetRows) {\n    const data = {};\n    for (const [h, [col, how]] of Object.entries(T.map)) data[col] = conv(r[h], how);\n    const k = keyOf(data, T.keyCols);\n    if (!T.keyCols.every(c => str(data[c]))) continue;          // blank / note rows\n    if (wanted.has(k)) { s.skipped.push(`Duplicate key in sheet: ${k}`); continue; }\n    wanted.set(k, data);\n  }\n  s.sheet_rows = wanted.size;\n  if (!wanted.size) { s.skipped.push('Sheet returned no rows; table not synced'); continue; }\n\n  const existing = new Map();\n  for (const r of tableRows) { const k = keyOf(r, T.keyCols); if (!existing.has(k)) existing.set(k, r); }\n\n  for (const [k, data] of wanted) {\n    const cur = existing.get(k);\n    if (!cur) { s.inserts++; s.changes.push(`+ ${k}`); out.push({ json: { route: `${T.key}-upsert`, key: k, data } }); continue; }\n    const diff = Object.keys(data).filter(c => !same(data[c], cur[c]));\n    if (diff.length) {\n      s.updates++; s.changes.push(`~ ${k}: ${diff.map(c => `${c} \"${str(cur[c])}\" -> \"${str(data[c])}\"`).join(', ')}`);\n      out.push({ json: { route: `${T.key}-upsert`, key: k, data } });\n    }\n  }\n  const gone = [...existing.entries()].filter(([k]) => !wanted.has(k));\n  if (gone.length && CONFIG.DELETE_MISSING) {\n    if (gone.length > tableRows.length * CONFIG.MAX_DELETE_RATIO) {\n      s.skipped.push(`${gone.length} of ${tableRows.length} rows are missing from the sheet; deletes skipped (max_delete_ratio ${CONFIG.MAX_DELETE_RATIO})`);\n    } else for (const [k, r] of gone) { s.deletes++; s.changes.push(`- ${k}`); out.push({ json: { route: `${T.key}-delete`, key: k, id: r.id } }); }\n  } else if (gone.length) s.skipped.push(`${gone.length} table rows not in the sheet (delete_missing_rows is off): ${gone.map(([k]) => k).join(', ')}`);\n}\n\n// Always return the summary first; change items follow unless this is a dry run.\nreturn [{ json: { route: 'summary', dry_run: CONFIG.DRY_RUN, summary } }, ...(CONFIG.DRY_RUN ? [] : out)];\n"
      }
    },
