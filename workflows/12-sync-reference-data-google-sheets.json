  "nodes": [
    {
      "id": "5aaec9b0-a7ed-4daa-93c0-5ce10b6559fa",
      "name": "Build Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1984,
        544
      ],
      "parameters": {
        "jsCode": "// Settings come from the summers.datastore.config.keys data table: { CATEGORY: { key: value } }.\nconst parse = v => {\n  if (v === null || v === undefined) return null;\n  const s = String(v).trim();\n  if (/^(true|false)$/i.test(s)) return s.toLowerCase() === 'true';\n  if (/^-?\\d+(\\.\\d+)?$/.test(s)) return Number(s);\n  if (/^[\\[{]/.test(s)) { try { return JSON.parse(s); } catch (e) { /* keep as text */ } }\n  return s;\n};\nconst cfg = {};\nfor (const { json: r } of $input.all()) {\n  if (!r || !r.category || !r.key) continue;\n  (cfg[r.category] ||= {})[r.key] = parse(r.value);\n}\n// Fail loudly if a required setting is missing, rather than running with a guess.\nconst REQUIRED = [\"SHEET_SYNC_CONFIG.spreadsheet_id\", \"SHEET_SYNC_CONFIG.location_tab_gid\", \"SHEET_SYNC_CONFIG.department_tab_gid\", \"SHEET_SYNC_CONFIG.vendor_map_tab_gid\", \"SHEET_SYNC_CONFIG.vendor_map_header_row\", \"SHEET_SYNC_CONFIG.delete_missing_rows\", \"SHEET_SYNC_CONFIG.dry_run\"];\nconst missing = REQUIRED.filter(p => { const [c, k] = p.split('.'); const v = cfg[c]?.[k]; return v === undefined || v === null || v === ''; });\nif (missing.length) throw new Error('Missing settings in summers.datastore.config.keys: ' + missing.join(', '));\nreturn [{ json: { cfg } }];\n"
      }
    },
