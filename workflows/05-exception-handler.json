    {
      "id": "ed201e4d-f278-49f6-8a24-9f026092b111",
      "name": "Format Exception",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1248,
        880
      ],
      "parameters": {
        "jsCode": "// ===== CONFIG =====\nconst E = $('Build Config').first().json.cfg.EMAIL_CONFIG;\nconst CONFIG = {\n  NOTIFY_TO: E.exception_notify_to,\n  SILENT_STATUSES: Array.isArray(E.silent_statuses) ? E.silent_statuses : [E.silent_statuses],   // logged, no email\n};\nconst ctx = $('Start').first().json;\nconst status = ctx.status || 'EXCEPTION';\nconst category = status === 'DUPLICATE' ? 'DUPLICATE' : status === 'POST_FAILED' ? 'POST_FAILED' : 'EXCEPTION';\nconst inv = ctx.invoice || {};\nconst esc = v => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst rows = [\n  ['Status', status], ['Reason', ctx.reason], ['Vendor', ctx.vendor?.name], ['Invoice #', inv.invoice_number],\n  ['Invoice date', inv.invoice_date], ['PO', ctx.po?.raw || inv.po_number_raw], ['Account #', inv.account_number],\n  ['Total', inv.invoice_total],\n  ['Location', ctx.location?.code ? `${ctx.location.code} (${ctx.location.entity_id ?? '?'}) via ${ctx.location.method}` : ctx.location?.status],\n  ['Lane', ctx.lane], ['File', ctx.file_name], ['Email subject', ctx.subject],\n  ['Warnings', (ctx.warnings || []).join('; ')], ['Tracking row', ctx.tracking_id],\n].filter(([, v]) => v !== undefined && v !== null && v !== '');\nconst fmt = v => (v === null || v === undefined || v === '') ? '' : (typeof v === 'number' ? v.toFixed(2) : String(v));\nconst th = 'padding:6px;text-align:left;background:#374151;color:#FFFFFF;font-weight:bold';\nconst td = 'padding:6px;border-bottom:1px solid #E5E7EB';\nconst detailTable =\n  `<table style=\"border-collapse:collapse;width:100%\">` +\n  rows.map(([k, v], i) => `<tr style=\"background:${i % 2 ? '#F9FAFB' : '#FFFFFF'}\"><td style=\"padding:6px;font-weight:bold;width:30%;color:#374151\">${esc(k)}</td><td style=\"padding:6px\">${esc(v)}</td></tr>`).join('') +\n  `</table>`;\nconst checks = ctx.match_checks || {};\nconst checksTable = Object.keys(checks).length\n  ? `<h4 style=\"color:#374151;margin:16px 0 6px\">PO match checks</h4><table style=\"border-collapse:collapse;width:100%\">` +\n    `<tr><th style=\"${th}\">Check</th><th style=\"${th}\">Result</th><th style=\"${th}\">Detail</th></tr>` +\n    Object.entries(checks).map(([k, v]) => `<tr><td style=\"${td}\">${esc(k)}</td><td style=\"${td};font-weight:bold;color:${v.result === 'FAIL' ? '#B91C1C' : v.result === 'PASS' ? '#047857' : '#374151'}\">${esc(v.result)}</td><td style=\"${td}\">${esc(v.detail ?? '')}</td></tr>`).join('') +\n    `</table>` : '';\nconst vl = Array.isArray(ctx.variance_lines) ? ctx.variance_lines : [];\nconst varianceTable = vl.length\n  ? `<h4 style=\"color:#374151;margin:16px 0 6px\">Line variance (invoice vs ServiceTitan PO)</h4><table style=\"border-collapse:collapse;width:100%;font-size:13px\">` +\n    `<tr>${['SKU', 'Description', 'PO qty', 'Inv qty', 'PO unit', 'Inv unit', 'PO ext', 'Inv ext', 'Diff', 'Status'].map(h => `<th style=\"${th}\">${h}</th>`).join('')}</tr>` +\n    vl.map(r => `<tr style=\"background:${r.status === 'OK' ? '#FFFFFF' : '#FEF2F2'}\">` +\n      [r.sku, r.description, r.po_qty, r.inv_qty, r.po_unit, r.inv_unit, r.po_ext, r.inv_ext, r.diff, r.status]\n        .map((v, i) => `<td style=\"${td}${i === 9 && r.status !== 'OK' ? ';color:#B91C1C;font-weight:bold' : ''}\">${esc(i >= 2 && i <= 8 ? fmt(v) : v)}</td>`).join('') + `</tr>`).join('') +\n    `</table>` +\n    (ctx.variance_amount !== null && ctx.variance_amount !== undefined ? `<p style=\"margin:8px 0 0\"><b>Total variance (invoice - PO):</b> ${esc(fmt(ctx.variance_amount))}</p>` : '')\n  : '';\nconst html =\n  `<div style=\"font-family:Lato,Arial,sans-serif;font-size:14px;color:#111827;max-width:760px\">` +\n  `<h3 style=\"color:#462CED;margin:0 0 8px\">AP ${esc(category.toLowerCase().replace('_', ' '))}: ${esc(status)}</h3>` +\n  detailTable + checksTable + varianceTable + `</div>`;\n\n// Flat fields for the Daily Report table\nconst report = {\n  document_id: ctx.doc_id ?? '',\n  lane: ctx.lane ?? ctx.route ?? '',\n  po_number: ctx.po?.normalized ?? inv.po_number_raw ?? '',\n  location_id: ctx.location?.entity_id ?? '',\n  location_name: ctx.location?.code ? `${ctx.location.code} / ${ctx.location.name ?? ctx.location.entity_id ?? ''}` : '',\n  location_method: ctx.location?.method ?? ctx.location?.status ?? '',\n  st_po_number: ctx.st_po?.number ?? '',\n  st_po_id: ctx.st_po?.id != null ? String(ctx.st_po.id) : '',\n  st_po_status: ctx.st_po ? (ctx.st_po.status ?? 'FOUND') : (/^PO_NOT_FOUND|PO_AMBIGUOUS|PO_CANCELED|ST_API_ERROR/.test(status) ? status : ''),\n  line_count: ctx.line_count ?? (inv.line_items || []).length,\n  variance_amount: ctx.variance_amount ?? null,\n  invoice_vendor_mismatch: checks.vendor?.result ?? '',\n  invoice_location_mismatch: checks.location?.result ?? (status === 'LOCATION_CONFLICT' ? 'FAIL' : ''),\n  invoice_qty_mismatch: checks.quantity?.result ?? '',\n  invoice_price_mismatch: checks.total?.result ?? '',\n  match_details: Object.entries(checks).map(([k, v]) => `${k}: ${v.result}${v.detail ? ' (' + v.detail + ')' : ''}`).join(' | ').slice(0, 2000),\n  warnings: (ctx.warnings || []).join('; ').slice(0, 2000),\n};\nreturn [{ json: {\n  ctx,\n  report,\n  tracking_id: ctx.tracking_id ?? null,\n  processing_status: category,\n  exception_reason: `${status}: ${ctx.reason || 'no detail'}`.slice(0, 2000),\n  notify: !CONFIG.SILENT_STATUSES.includes(status),\n  notify_to: CONFIG.NOTIFY_TO,\n  email_subject: `[AP ${category}] ${status} | ${ctx.vendor?.name ?? 'Unknown vendor'} ${inv.invoice_number ?? ''}`.trim(),\n  email_html: html,\n} }];\n"
      }
    },
